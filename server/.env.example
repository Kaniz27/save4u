PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/save4u
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Used only by npm run seed to create the first admin account
SEED_ADMIN_EMAIL=admin@save4u.co.uk
SEED_ADMIN_PASSWORD=change-this-password

# Email notifications when a lead form is submitted.
# Leave SMTP_HOST empty to skip sending (leads still save to the database).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@save4u.co.uk
NOTIFY_EMAIL=support@save4u.co.uk
